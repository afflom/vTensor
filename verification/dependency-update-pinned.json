{
  "updates": [
    {
      "commit-message": {
        "prefix": "chore(deps)"
      },
      "directory": "/",
      "exclude-paths": [
        ".github/workflows/bootstrap.yml"
      ],
      "groups": {
        "pinned-actions": {
          "patterns": [
            "*"
          ]
        }
      },
      "ignore": [
        {
          "dependency-name": "UOR-Foundation/PrismPM/action"
        }
      ],
      "package-ecosystem": "github-actions",
      "schedule": {
        "interval": "weekly"
      }
    },
    {
      "commit-message": {
        "prefix": "chore(deps)"
      },
      "directory": "/",
      "groups": {
        "build-policy": {
          "patterns": [
            "*"
          ]
        }
      },
      "ignore": [
        {
          "dependency-name": "unicode-normalization"
        }
      ],
      "package-ecosystem": "cargo",
      "schedule": {
        "interval": "weekly"
      }
    }
  ],
  "version": 2
}
